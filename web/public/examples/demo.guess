": {"hierarchy": true, "freq": 191, "color": "102,89,111,255", "width": 1.5}}, {"s": 379, "t": 379, "d": false, "alive": false, "vals": {"hierarchy": true, "freq": 39}}, {"s": 383, "t": 383, "d": false, "alive": false, "vals": {"hierarchy": true, "freq": 35}}, {"s": 386, "t": 386, "d": false, "alive": false, "vals": {"hierarchy": true, "freq": 139}}], "deleted": [["e", 722], ["n", 379], ["n", 380], ["n", 381], ["n", 382], ["e", 723], ["n", 383], ["n", 384], ["n", 385], ["e", 724], ["n", 386], ["n", 387], ["n", 388], ["n", 389], ["n", 390], ["n", 391], ["n", 392], ["n", 393], ["n", 394], ["n", 395], ["n", 396], ["n", 397], ["n", 398], ["n", 399], ["n", 400], ["n", 401]], "states": [], "ranges": [], "hulls": [], "legends": [{"i": 2, "entries": [{"k": "n", "c": 6411054, "a": 1.0, "s": 2, "t": "dept9"}, {"k": "n", "c": 5733255, "a": 1.0, "s": 2, "t": "dept6"}, {"k": "n", "c": 9010719, "a": 1.0, "s": 2, "t": "dept1"}, {"k": "n", "c": 6548049, "a": 1.0, "s": 2, "t": "dept20"}, {"k": "n", "c": 7145084, "a": 1.0, "s": 2, "t": "dept2"}, {"k": "n", "c": 5564800, "a": 1.0, "s": 2, "t": "dept4"}]}], "view": {"background": "white", "image": null, "arrow": {"length": null, "width": null}}, "script": "# Demo app: an edge-frequency threshold slider, department picker and\n# click-to-focus, in the spirit of the paper's political-blog applet.\nthreshold = Label(\"\")\n\ndef show_edges(val):\n    (freq < val).visible = false\n    (freq >= val).visible = true\n    threshold.text = \"%d of %d edges\" % (len(Edge.visible == true), len(g.edges))\n\nslider = Slider(freq.min, freq.max + 1, label=\"Min. frequency\", onChange=show_edges)\n\ndef pick(dept_name):\n    if dept_name == \"(all)\":\n        g.nodes.labelvisible = false\n        center()\n    else:\n        g.nodes.labelvisible = false\n        members = dept == dept_name\n        members.labelvisible = true\n        center(members)\n\ndepts = Dropdown([\"(all)\"] + sorted(set(dept.values())), label=\"Department\", onChange=pick)\nui.dock(Panel(\"Explore\", slider, threshold, depts))\n\ngraphevents.clickNode = lambda n: center([n] + n.getNeighbors())\nStatusBar.setStatus(\"Click a node to focus on its neighbourhood\")\nshow_edges(freq.min)\n", "app": true}