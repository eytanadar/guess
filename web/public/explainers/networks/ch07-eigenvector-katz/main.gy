# Eigenvector and Katz centrality  (Newman, Networks, Sections 7.1.1-7.1.3)
# Degree counts a node's neighbours. Eigenvector centrality counts important
# neighbours: each node's score is the sum of its neighbours' scores, x = A x / kappa1,
# found by starting anywhere and repeating x <- A x (the power iteration).
# In a directed network a node no one points to gets zero, and so does every
# node that only it points to. Katz centrality gives every node a free amount
# beta as well: x = alpha A x + beta, with alpha below 1/kappa1. Small alpha
# ranks nodes almost by degree, alpha near 1/kappa1 almost by eigenvector.

import numpy as np
import networkx as nx

# ---- the two networks ---------------------------------------------------------------------------
KG = nx.karate_club_graph()
KG = nx.relabel_nodes(KG, {v: f"k{v + 1}" for v in KG})
kpos = nx.spring_layout(KG, seed=17, iterations=300)
for v in KG:
    KG.nodes[v]["pos"] = (kpos[v][0] * 540, kpos[v][1] * 540)
    KG.nodes[v]["label"] = v[1:]
fromNetworkX(KG, "karate")
KNAMES = sorted(KG, key=lambda v: int(v[1:]))
KA = nx.to_numpy_array(KG, nodelist=KNAMES, weight=None)

# a directed network: a core where links go round (A..E), pages that only point
# in (sources, and the nodes only they point to), and some that the core points out to
DEDGES = [("A", "B"), ("B", "C"), ("C", "D"), ("D", "A"), ("C", "A"), ("D", "E"), ("E", "B"),
          ("S1", "P1"), ("P1", "P2"), ("P2", "A"), ("S2", "P2"), ("S3", "Q1"), ("Q1", "C"),
          ("E", "F"), ("F", "G"), ("B", "H"), ("H", "G"), ("D", "I")]
DPOS = {"A": (0, 0), "B": (150, -90), "C": (170, 80), "D": (20, 170), "E": (290, -10),
        "S1": (-420, -150), "P1": (-290, -110), "P2": (-150, -40), "S2": (-310, 40),
        "S3": (-120, 330), "Q1": (90, 300), "F": (430, -80), "G": (480, 90), "H": (300, -200), "I": (-60, 320)}
DG = nx.DiGraph(DEDGES)
for v in DG:
    DG.nodes[v]["pos"] = DPOS[v]
fromNetworkX(DG, "directed")
DNAMES = sorted(DG)
DA = np.zeros((len(DNAMES), len(DNAMES)))
for u, v in DEDGES:
    DA[DNAMES.index(v), DNAMES.index(u)] = 1.0           # A_ij = 1 for an edge from j to i
DKAPPA = float(max(abs(np.linalg.eigvals(DA))))
DKATZ = 0.6 / DKAPPA                                       # Katz's alpha for the directed network
use("karate")
closeGraph("main") if "main" in graphNames() else None


def nd(v):
    return g.getNodeByName(v)


def edges_between(u, v):
    return [e for e in g.edges if {e.node1.name, e.node2.name} == {u, v}]


def plain(size=24):
    for n in g.nodes:
        n.width = n.height = size
        n.color = "180,195,215"
        n.strokecolor = "70,70,70"
        n.labelpos = "inside"
        n.labelvisible = true
    for e in g.edges:
        e.color, e.width, e.linestyle = "150,150,150,150", 1.5, "solid"


def show_sizes(names, vals, lo=22, hi=60, hot=None):
    top = max(vals) if len(vals) and max(vals) > 0 else 1
    for v, val in zip(names, vals):
        n = nd(v)
        t = val / top
        n.width = n.height = lo + (hi - lo) * t
        n.color = f"{int(250 - 40 * t)},{int(225 - 150 * t)},{int(140 - 110 * t)}"
        n.strokecolor = "70,70,70"
    if hot:
        n = nd(hot)
        n.strokecolor = "200,30,30"


# ---- power iteration (undirected) ---------------------------------------------------------------
eig = np.linalg.eigh(KA)
KAPPA = float(eig[0][-1])
VEC = np.abs(eig[1][:, -1])
VEC = VEC / VEC.max()
power = {"x": np.ones(len(KNAMES)), "t": 0, "changes": [], "kappa": [], "timer": None, "start": "all ones"}


def reset_power(how="all ones"):
    if power["timer"] is not None:
        power["timer"].stop()
        power["timer"] = None
    x = np.ones(len(KNAMES)) if how == "all ones" else np.zeros(len(KNAMES))
    if how.startswith("one node"):
        x[KNAMES.index("k12")] = 1.0                 # a node with one neighbour: the score has to travel
    power.update(x=x, t=0, changes=[], kappa=[], start=how)
    plain()
    show_sizes(KNAMES, x)
    iter_btn.text = "Iterate"


def power_step():
    x = power["x"]
    new = KA @ x
    k_est = float(np.linalg.norm(new) / (np.linalg.norm(x) or 1))
    new = new / (new.max() or 1)
    old = x / (x.max() or 1)
    power["changes"].append((power["t"] + 1, float(np.abs(new - old).max()) + 1e-12))
    power["kappa"].append((power["t"] + 1, k_est))
    power["x"] = new
    power["t"] += 1
    # highlight where the biggest rise came from: the edges into the node that gained most
    gain = new - old
    hot = KNAMES[int(np.argmax(gain))] if gain.max() > 1e-6 else KNAMES[int(np.argmax(new))]
    for e in g.edges:
        e.color, e.width, e.linestyle = "150,150,150,150", 1.5, "solid"
    for e in g.edges:
        if hot in (e.node1.name, e.node2.name):
            e.color, e.width, e.linestyle = "230,120,30", 3.5, "flow"
    show_sizes(KNAMES, new, hot=hot)
    return 40 - power["t"] if power["t"] < 40 else False


def play_power():
    if power["timer"] is not None and power["timer"].running:
        power["timer"].stop()
        power["timer"] = None
        iter_btn.text = "Iterate"
        return
    power["timer"] = everyPaced(power_step, slow=0.9, fast=0.2, ramp=3)
    iter_btn.text = "Pause"


def power_chart():
    if not power["changes"]:
        return None
    return plotLine({"largest change in a score": power["changes"]}, title="Power iteration: change per step",
                    xlabel="step", ylabel="change", logY=true, dots=true)


def power_text():
    x = power["x"] / (power["x"].max() or 1)
    t = power["t"]
    deg = KA.sum(axis=1)
    top_e = [KNAMES[i][1:] for i in np.argsort(-x)[:5]]
    top_d = [KNAMES[i][1:] for i in np.argsort(-deg, kind="stable")[:5]]
    k_est = power["kappa"][-1][1] if power["kappa"] else float("nan")
    err = float(np.abs(x - VEC).max())
    return (f"Step **{t}** (start: {power['start']}). Each step replaces every score by the **sum of its "
            f"neighbours' scores** (then rescales so the top is 1). The ratio of sizes before and after is "
            f"**{k_est:.3f}**, heading for κ₁ = **{KAPPA:.3f}**, the largest eigenvalue of A. Distance from the "
            f"eigenvector: **{err:.4f}**.\n\nTop five now: **{', '.join(top_e)}**; by degree: {', '.join(top_d)}. "
            "The orange node is the one that gained most this step; its edges carry the gain.")


# ---- directed: zeros spread ---------------------------------------------------------------------
dpow = {"x": np.ones(len(DNAMES)), "t": 0, "timer": None, "katz": False}
DOUT = {v: [w for u, w in DEDGES if u == v] for v in DNAMES}
DIN = {v: [u for u, w in DEDGES if w == v] for v in DNAMES}


def dpaint(newzero=()):
    x = dpow["x"]
    top = x.max() or 1
    for i, v in enumerate(DNAMES):
        n = nd(v)
        n.labelpos = "inside"
        n.labelvisible = true
        if x[i] <= 1e-12:
            n.width = n.height = 26
            n.color = "225,225,225"
            n.strokecolor = "200,30,30" if v in newzero else "150,150,150"
        else:
            t = x[i] / top
            n.width = n.height = 26 + 34 * t
            n.color = f"{int(250 - 40 * t)},{int(225 - 150 * t)},{int(140 - 110 * t)}"
            n.strokecolor = "70,70,70"
    for e in g.edges:
        e.color, e.width, e.linestyle = "150,150,150,200", 3, "solid"
        if e.node1.name in newzero:
            e.color, e.width, e.linestyle = "200,40,40", 3.5, "dashed"


def dreset():
    if dpow["timer"] is not None:
        dpow["timer"].stop()
        dpow["timer"] = None
    dpow.update(x=np.ones(len(DNAMES)), t=0, katz=False)
    dpaint()


def dstep():
    x = dpow["x"]
    new = (DKATZ * (DA @ x) + 1.0) if dpow["katz"] else DA @ x
    zero_before = {v for i, v in enumerate(DNAMES) if x[i] <= 1e-12}
    new = new / (new.max() or 1)
    new[new < 1e-12] = 0.0
    dpow["x"] = new
    dpow["t"] += 1
    newzero = {v for i, v in enumerate(DNAMES) if new[i] <= 1e-12} - zero_before
    dpaint(newzero)
    return 12 - dpow["t"] if dpow["t"] < 12 else False


def dplay(katz=False):
    if dpow["timer"] is not None:
        dpow["timer"].stop()
    dpow.update(x=np.ones(len(DNAMES)), t=0, katz=katz)
    dpaint()
    dpow["timer"] = everyPaced(dstep, slow=1.0, fast=0.35, ramp=2)


def dtext():
    x = dpow["x"]
    zeros = [v for i, v in enumerate(DNAMES) if x[i] <= 1e-12]
    what = ("Katz: x ← αAx + β with β = 1, so every node keeps at least β" if dpow["katz"]
            else "eigenvector: x ← Ax, the sum of the scores of the nodes pointing **in**")
    return (f"Step **{dpow['t']}**, {what}.\n\n**{len(zeros)}** of {len(DNAMES)} nodes have score zero"
            + (f": {', '.join(zeros)}" if zeros else "") + ". "
            + ("S1, S2 and S3 have no in-links, so they get nothing; then P1 and Q1 (pointed to only by them) get "
               "nothing, then P2. Red outlines and dashed links mark the zeros spreading. Only the core A–E, "
               "where links go round, and what it points to (F, G, H, I) keep a score."
               if not dpow["katz"] else
               "No zeros: the free β gives sources a score, which they pass on. That is the point of Katz centrality."))


# ---- Katz: alpha from degree to eigenvector ------------------------------------------------------
frac = Slider(1, 99, 50, 1, label="α as % of 1/κ₁")
katzs = {"sweep": None}


def ranks(v):
    order = np.argsort(np.argsort(-np.asarray(v), kind="stable"), kind="stable")
    return order.astype(float)


def spearman(a, b):
    ra, rb = ranks(a), ranks(b)
    return float(np.corrcoef(ra, rb)[0, 1])


def katz_values(f):
    a = (f / 100.0) / KAPPA
    return np.linalg.solve(np.eye(len(KNAMES)) - a * KA, np.ones(len(KNAMES))), a


def show_katz(v=None):
    f = float(frac.value)
    fld, limit = katzCentrality(alpha=(f / 100.0) * (1.0 / KAPPA), beta=1)
    vals = [nd(v).katz for v in KNAMES]
    plain()
    show_sizes(KNAMES, vals)


def katz_text():
    f = float(frac.value)
    vals, a = katz_values(f)
    deg = KA.sum(axis=1)
    rows = ["| rank | degree | Katz | eigenvector |", "|---|---|---|---|"]
    od, ok_, oe = np.argsort(-deg, kind="stable"), np.argsort(-vals), np.argsort(-VEC)
    for r in range(6):
        rows.append(f"| {r + 1} | {KNAMES[od[r]][1:]} ({int(deg[od[r]])}) | {KNAMES[ok_[r]][1:]} | {KNAMES[oe[r]][1:]} |")
    return (f"α = **{a:.4f}**; the limit 1/κ₁ = {1 / KAPPA:.4f}. Rank correlation with degree **{spearman(vals, deg):.3f}**, "
            f"with eigenvector centrality **{spearman(vals, VEC):.3f}**. *Simulate* sweeps α and charts how far the "
            "ranking is from each (lower is closer): the lines cross as Katz turns from degree-like to "
            "eigenvector-like.\n\n" + "\n".join(rows))


def sweep():
    deg = KA.sum(axis=1)
    pd, pe = [], []
    for f in range(2, 100, 4):
        vals, a = katz_values(f)
        pd.append((f, max(1e-4, 1 - spearman(vals, deg))))
        pe.append((f, max(1e-4, 1 - spearman(vals, VEC))))
    katzs["sweep"] = {"from degree": pd, "from eigenvector": pe}


def katz_chart():
    if katzs["sweep"] is None:
        return plotScatter("degree", "katz", title="Katz score against degree")
    return plotLine(katzs["sweep"], title="How far Katz's ranking is from degree's and eigenvector's",
                    xlabel="α (% of 1/κ₁)", ylabel="1 − rank correlation", logY=true, dots=true)


def clear_sweep():
    katzs["sweep"] = None


# ---- tabs -------------------------------------------------------------------------------------
current = ["Power iteration"]


def switch(title):
    current[0] = title
    for t in (power["timer"], dpow["timer"]):
        if t is not None:
            t.stop()
    power["timer"] = dpow["timer"] = None
    iter_btn.text = "Iterate"
    if title.startswith("Directed"):
        use("directed")
        dreset()
    else:
        use("karate")
        if title.startswith("Katz"):
            show_katz()
        else:
            plain()
            show_sizes(KNAMES, power["x"])
    center()


iter_btn = Button("Iterate", onClick=play_power)
frac.onChange = show_katz
frac.onSlide = show_katz
reset_power()
constantLabelSize(size=14)
ui.title("Eigenvector and Katz centrality", "Networks, Sections 7.1.1–7.1.3")
ui.layout(
    right=Column(
        Markdown("""### Important friends count more
Zachary's karate club. A node's **eigenvector centrality** is proportional
to the sum of its neighbours' centralities; **Katz** adds a little for free."""),
        Tabs(
            Tab("Power iteration",
                Row(iter_btn, Button("Step", onClick=power_step),
                    Button("Start from ones", onClick=lambda: reset_power("all ones")),
                    Button("Start from one node", onClick=lambda: reset_power("one node (12)"))),
                Markdown(power_text), Chart(power_chart)),
            Tab("Directed: zeros spread",
                Row(Button("Iterate x ← Ax", onClick=lambda: dplay(False)),
                    Button("Iterate Katz x ← αAx + β", onClick=lambda: dplay(True)),
                    Button("Step", onClick=dstep), Button("Reset", onClick=dreset)),
                Markdown(dtext)),
            Tab("Katz α",
                frac,
                Row(Button("Simulate: sweep α", onClick=sweep), Button("Scatter against degree", onClick=clear_sweep)),
                Chart(katz_chart), Markdown(katz_text)),
            onChange=switch)),
    sizes={"right": 410},
)
ui.toolbar(Action("tool:select"), Action("fit"), Action("png"), "|", Action("source", "How this is built"))
ui.statusbar(Label(lambda: f"{graphNames()[0]}: {len(g.nodes)} nodes · {len(g.edges)} edges"))
center()
