                    Button("Scatter", onClick=lambda: scatter()),
                    Button("Lay out from the edges", onClick=lambda: from_edges())),
                Markdown(latent_text)),
            onChange=switch)),
    sizes={"right": 410},
)
ui.toolbar(Action("tool:select"), Action("fit"), Action("png"), "|", Action("source", "How this is built"))
ui.statusbar(Label(lambda: f"{mode[0]}: {len(g.nodes)} nodes · {len(g.edges)} edges"))
