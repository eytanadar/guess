                Button("One group each (Louvain)", onClick=lambda: one_each()),
                Markdown(overlap_text)),
            Tab("Hierarchy",
                Row(Slider(1, 10, 4, 1, label="groups", onChange=set_k),
                    Dropdown(["average", "complete", "single"], label="linkage", onChange=set_link)),
                Button("Merge step by step", onClick=lambda: merge_play()),
                Markdown(hier_text), Chart(dendro_chart)),
            Tab("Core and periphery",
                Dropdown(CP_NETS, label="Network", onChange=pick_core_net),
                Row(Button("Find core and periphery", onClick=lambda: find_core()),
                    Button("Plain block model, 2 groups", onClick=lambda: plain_sbm())),
                Markdown(core_text), Chart(core_matrix)),
            Tab("Ranking",
                Row(Button("Rank them", onClick=lambda: rank_them()), scr_btn),
