# Asking people who their friends are  (Newman, Networks, Section 4.2)
# Surveys use a "name generator": name your best friend, your second best, ...
# Each answer is a nomination from one person to another, so the result is a
# directed network, and nominations are not always returned. A limit on how
# many names people may give caps everyone's out-degree, but anyone can still
# be named by many. The school, its friendships and its survey are invented.

import random
import networkx as nx

rnd = random.Random(21)
N = 120
STUDENTS = [f"s{i}" for i in range(N)]
# the true friendships: a few very sociable students, most with a handful of friends
true_friends = nx.powerlaw_cluster_graph(N, 3, 0.4, seed=21)
true_friends = nx.relabel_nodes(true_friends, {i: STUDENTS[i] for i in range(N)})
# advice: everyone asks the few they see as knowing best, so it is directed from the start
expertise = {s: rnd.paretovariate(1.6) for s in STUDENTS}
TRUE = {"Who are your best friends?": true_friends}
advice = nx.DiGraph()
for s in STUDENTS:
    others = [t for t in true_friends[s]] + rnd.sample(STUDENTS, 6)
    for t in sorted(set(others) - {s}, key=lambda t: -expertise[t])[:4]:
        advice.add_edge(s, t)
TRUE["Whom do you ask for advice?"] = advice

pos = nx.spring_layout(true_friends, seed=21, iterations=120)
H = nx.DiGraph()
for s in STUDENTS:
    H.add_node(s, pos=(pos[s][0] * 600, pos[s][1] * 600), label=s)
fromNetworkX(H)
NODE = {n.name: n for n in g.nodes}
limit = Slider(1, 11, 8, 1, label="names allowed (11 = no limit)")
question = ["Who are your best friends?"]
FORGET = 0.15            # each friend is left off a list with this probability


def survey():
    """Each student lists true contacts, closest first, up to the limit."""
    remove(list(g.edges))
    net = TRUE[question[0]]
    cap = None if limit.value >= 11 else int(limit.value)
    r = random.Random(7)
    for s in STUDENTS:
        listed = [t for t in (net.successors(s) if net.is_directed() else net[s]) if r.random() > FORGET]
        r.shuffle(listed)
        for t in listed[:cap]:
            addDirectedEdge(NODE[s], NODE[t])
    sizeBy(indegree, 5, 30)
    colorBy(outdegree, "200,210,230", "30,70,160")
    g.edges.color = "140,140,140,90"


def survey_text():
    net = TRUE[question[0]]
    true_deg = dict(net.degree()) if not net.is_directed() else dict(net.out_degree())
    outs = [n.outdegree for n in g.nodes]
    ins = [n.indegree for n in g.nodes]
    cap = "no limit" if limit.value >= 11 else f"at most **{int(limit.value)}** names"
    hidden = sorted(STUDENTS, key=lambda s: -true_deg[s])[:5]
    shown = [NODE[s].outdegree for s in hidden]
    mutual = reciprocity()
    capped = limit.value < 11
    head = (f"With {cap}: the most names anyone gave is **{max(outs)}**, and the most-named "
            f"student was named **{max(ins)}** times."
            + (" Out-degree is capped; in-degree is not." if capped else ""))
    if net.is_directed():
        return (head + f"\n\nAdvice runs one way: only **{100 * mutual:.0f}%** of nominations are "
                "returned, and a few students are asked by many (the biggest dots).")
    return (head + f"\n\nThe five most connected students really have "
            f"**{', '.join(str(true_deg[s]) for s in hidden)}** friends; the survey records "
            f"**{', '.join(map(str, shown))}**. **{100 * mutual:.0f}%** of nominations are returned "
            "(reciprocity).")


def ask(choice):
    question[0] = choice
    survey()


limit.onChange = lambda v: survey()
survey()
hoverFields("indegree", "outdegree")
ui.title("Asking people who their friends are", "Networks, Section 4.2")
ui.layout(
    right=Column(
        Markdown("""### The name generator
Each of 120 (invented) students answers a question by listing names. Each
name is an **arrow** from the one who named to the one named, and the arrow
isn't always returned. Colour shows how many names a student gave
(**out-degree**); size shows how often they were named (**in-degree**).
People also forget: each friend is left off a list 15% of the time."""),
        Dropdown(list(TRUE), label="Question", onChange=ask),
        limit,
        Markdown(survey_text),
        Row(Chart(lambda: plotFrequency(outdegree)), Chart(lambda: plotFrequency(indegree))),
        Markdown("""*Try:* allow 3 names, then no limit. A fixed-choice survey hides the hubs among
those **naming**, so the network looks more even than it is. Asking several
questions gives several networks on the same people, a **multiplex** network.""")),
    sizes={"right": 420},
)
ui.toolbar(Action("tool:select"), Action("fit"), Action("png"), "|", Action("source", "How this is built"))
ui.statusbar(Label(lambda: f"{len(g.nodes)} students · {len(g.edges)} nominations (invented)"))
center()
