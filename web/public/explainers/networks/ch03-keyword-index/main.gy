# A book index is a network  (Newman, Networks, Section 3.3.3)
# An index lists words and the pages they are on: a bipartite network of words
# and pages. Pages that share many words are probably about the same thing,
# and latent semantic analysis (an SVD of the word-page matrix) finds pages
# that are similar even when they share few words. The "book" is Conan
# Doyle's "A Scandal in Bohemia" (public domain), cut into pages of about
# 1,800 characters.

import re
from collections import Counter
import numpy as np
import networkx as nx

with open("scandal-in-bohemia.txt", encoding="utf-8") as fh:
    paras = [p.strip() for p in fh.read().split("\n\n")[2:] if p.strip()]
pages, cur = [], ""
for p in paras:
    cur = (cur + "\n\n" + p).strip()
    if len(cur) > 1800:
        pages.append(cur)
        cur = ""
if cur:
    pages.append(cur)

STOP = set("""that with have this from they were what which their there would could your when been then
them will said into than upon very only some more down about such over also here even like just most
other well before after again should shall these those where while being once every through might much
must does done made make came come know think little upon himself herself myself yourself never still
back away good great long first last same each both under three quite take took nothing something
whom whose because however without within thing things side always seen seem seemed perhaps rather
want wish shall what asked cried remarked heard tell call find looked twice against part five half left
open time work hands name doubt matter minutes said answered upon sitting turned found ever along
round right going sure might without until thought know dear""".split())
words_by_page = [Counter(w for w in re.findall(r"[a-z’']{4,}", p.lower().replace("’s", "")) if w not in STOP)
                 for p in pages]
df = Counter(w for c in words_by_page for w in c)
terms = [w for w, k in df.most_common() if 3 <= k <= 0.6 * len(pages)][:45]

G = nx.Graph()
for i, c in enumerate(words_by_page):
    G.add_node(f"page{i + 1}", kind="page", label=f"p.{i + 1}", text=pages[i][:220].replace("\n", " ") + "…")
for w in terms:
    G.add_node(f"w_{w}", kind="word", label=w)
    for i, c in enumerate(words_by_page):
        if w in c:
            G.add_edge(f"w_{w}", f"page{i + 1}", count=c[w])

# the index drawing: pages in book order along the bottom, words above near their pages
P = len(pages)
for i in range(P):
    G.nodes[f"page{i + 1}"]["pos"] = (i * 1000 / (P - 1), 600)
mean_page = {w: sum(i for i, c in enumerate(words_by_page) if w in c) / df[w] for w in terms}
for k, w in enumerate(sorted(terms, key=lambda t: (mean_page[t], t))):
    G.nodes[f"w_{w}"]["pos"] = (k * 1000 / (len(terms) - 1), 120 + 60 * (k % 3))
fromNetworkX(G)
NODE = {n.name: n for n in g.nodes}


def dress():
    for n in g.nodes:
        n.labelvisible = true
        if n.kind == "page":
            n.color, n.style, n.width, n.height = "240,240,235", 1, 16, 20
            n.strokecolor = "90,90,90"
        else:
            n.color, n.style, n.width, n.height = "70,120,190", 2, 9, 9
    g.edges.color = "150,150,150,45"
    g.edges.width = 0.8


dress()
ss("index")

# latent semantic analysis: rank-k SVD of the word x page matrix (log counts)
A = np.array([[np.log1p(words_by_page[i][w]) for i in range(P)] for w in terms])
U, S, Vt = np.linalg.svd(A, full_matrices=False)
K = 6
page_vecs = (Vt[:K].T * S[:K])                    # one row per page
binary = (A > 0).astype(float).T                  # pages x words


def cos(M):
    norm = np.linalg.norm(M, axis=1, keepdims=True)
    norm[norm == 0] = 1
    X = M / norm
    return X @ X.T


SIM_WORDS, SIM_LSA = cos(binary), cos(page_vecs)

# the LSA drawing: pages and words placed by the 2nd and 3rd singular vectors
pts = {f"page{i + 1}": (Vt[1, i], Vt[2, i]) for i in range(P)}
pts.update({f"w_{w}": (U[j, 1], U[j, 2]) for j, w in enumerate(terms)})
xs, ys = [p[0] for p in pts.values()], [p[1] for p in pts.values()]
for k, (px, py) in pts.items():          # into the same area as the index drawing
    NODE[k].x = (px - min(xs)) / (max(xs) - min(xs)) * 1000
    NODE[k].y = 100 + (py - min(ys)) / (max(ys) - min(ys)) * 550
ss("lsa")
morph("index", 0)
chosen = [None]


def ranges(nums):
    out, start = [], None
    for k, v in enumerate(nums):
        if start is None:
            start = v
        if k + 1 == len(nums) or nums[k + 1] != v + 1:
            out.append(f"{start}–{v}" if v > start else str(v))
            start = None
    return ", ".join(out)


def choose(n):
    chosen[0] = n
    dress()
    n.color = "220,40,40"
    if n.kind == "word":
        for e in g.edges:
            if n in (e.node1, e.node2):
                e.color, e.width = "220,40,40", 2
                other = e.node2 if e.node1 is n else e.node1
                other.color = "250,200,180"
        return
    i = int(n.name[4:]) - 1
    for e in g.edges:
        if n in (e.node1, e.node2):
            e.color, e.width = "220,40,40,160", 1.5
    for j in top(SIM_WORDS, i):
        NODE[f"page{j + 1}"].color = "250,190,40"
    for j in top(SIM_LSA, i):
        NODE[f"page{j + 1}"].strokecolor = "120,40,160"
        NODE[f"page{j + 1}"].width = 22


def top(M, i, k=3):
    order = [j for j in np.argsort(-M[i]) if j != i]
    return order[:k]


def chosen_text():
    n = chosen[0]
    if n is None:
        return "*Click a word* (blue) to see its index entry, or *a page* (white) to find similar pages."
    if n.kind == "word":
        pg = sorted(int(e.node2.name[4:] if e.node1 is n else e.node1.name[4:]) for e in g.edges if n in (e.node1, e.node2))
        return f"Index entry: **{n.label}**, {ranges(pg)}"
    i = int(n.name[4:]) - 1
    shared = lambda j: ", ".join(w for w in terms if words_by_page[i][w] and words_by_page[j][w]) or "none"
    by_words = "\n".join(f"- p.{j + 1}: {SIM_WORDS[i, j]:.2f} (shares: {shared(j)})" for j in top(SIM_WORDS, i))
    by_lsa = "\n".join(f"- p.{j + 1}: {SIM_LSA[i, j]:.2f}" for j in top(SIM_LSA, i))
    return (f"**Page {i + 1}**: “{n.text}”\n\nMost similar by **shared index words** (yellow):\n{by_words}\n\n"
            f"Most similar by **LSA** (purple outline):\n{by_lsa}")


def to_lsa():
    morph("lsa", 1200)


def to_index():
    morph("index", 1200)


graphevents.clickNode = choose
dress()
hoverFields("label", "text")
ui.title("A book index is a network", "Networks, Section 3.3.3")
ui.layout(
    right=Column(
        Markdown(f"""### Words and pages
The index of a book is a **bipartite network**: {len(terms)} words (blue) each
linked to the pages they appear on (white; {P} pages of *A Scandal in
Bohemia*, in order). Pages that share many words probably cover the same
part of the story."""),
        Markdown(chosen_text),
        Group("Latent semantic analysis",
              Markdown("""LSA takes the word × page table, keeps its strongest few patterns (a
**singular value decomposition**), and compares pages by those patterns, so
two pages can be similar through words they *don't* share. Placing pages and
words by the second and third patterns draws the story's themes as a map."""),
              Row(Button("Place by LSA", onClick=to_lsa), Button("Back to the index", onClick=to_index)))),
    sizes={"right": 360},
)
ui.toolbar(Action("tool:select"), Action("fit"), Action("png"), "|", Action("source", "How this is built"))
ui.statusbar(Label(lambda: f"{P} pages · {len(terms)} words · {len(g.edges)} index entries"))
center()
