# Maximum flow by augmenting paths  (Newman, Networks, Section 8.7)
# The augmenting path algorithm (Ford-Fulkerson; with breadth-first search,
# Edmonds-Karp): look for a path from the source to the sink in the RESIDUAL
# network, push as much flow along it as its tightest edge allows, repeat.
# The residual network has an edge u->v wherever more flow can go from u to v:
# spare capacity on u->v, or flow already on v->u that could be sent back.
# Using such a backward edge cancels earlier flow, so a bad early choice gets
# undone. When no path is left, the nodes the source can still reach and the
# rest are the two sides of a minimum cut, whose capacity equals the flow.
# Node-independent paths: split each node into an "in" and an "out" half
# joined by an edge of capacity 1, and count the maximum flow.

import random
import networkx as nx

# ---- the networks -------------------------------------------------------------------------------
SMALL = {"pos": {"S": (0, 200), "A": (170, 50), "B": (170, 200), "C": (170, 350), "D": (360, 50),
                 "E": (360, 200), "F": (360, 350), "T": (540, 200)},
         "caps": {("S", "A"): 10, ("S", "B"): 5, ("S", "C"): 15, ("A", "B"): 4, ("A", "D"): 9, ("A", "E"): 15,
                  ("B", "C"): 4, ("B", "E"): 8, ("C", "F"): 16, ("D", "E"): 15, ("D", "T"): 10, ("E", "F"): 15,
                  ("E", "T"): 10, ("F", "B"): 6, ("F", "T"): 10},
         "src": "S", "snk": "T", "forced": []}
CANCEL = {"pos": {"S": (0, 200), "A": (260, 40), "B": (260, 360), "T": (520, 200)},
          "caps": {("S", "A"): 5, ("S", "B"): 5, ("A", "B"): 5, ("A", "T"): 5, ("B", "T"): 5},
          "src": "S", "snk": "T", "forced": [[("S", "A"), ("A", "B"), ("B", "T")]]}
CHOICES = {"A small network": SMALL, "Flow that has to be cancelled": CANCEL}

# two people-free routes between v0 and v9, plus a few shortcuts
BASE_POS = {"v0": (0, 200), "v1": (150, 40), "v2": (150, 200), "v3": (150, 360), "v4": (320, 100),
            "v5": (320, 300), "v6": (480, 40), "v7": (480, 200), "v8": (480, 360), "v9": (640, 200)}
BASE_EDGES = [("v0", "v1"), ("v0", "v2"), ("v0", "v3"), ("v1", "v4"), ("v2", "v4"), ("v2", "v5"), ("v3", "v5"),
              ("v4", "v6"), ("v4", "v7"), ("v5", "v7"), ("v5", "v8"), ("v6", "v9"), ("v7", "v9"), ("v8", "v9"),
              ("v1", "v6"), ("v3", "v8")]
BASE = nx.Graph(BASE_EDGES)


def to_graph(pos, caps, name):
    """Each capacity edge u->v becomes a forward edge u->v and a backward edge v->u (shown in the
    residual network when it carries flow)."""
    D = nx.DiGraph()
    for v, p in pos.items():
        D.add_node(v, pos=p)
    for (u, v), c in caps.items():
        D.add_edge(u, v, ekey=f"{u}>{v}", role="fwd", cap=c)
        D.add_edge(v, u, ekey=f"{u}>{v}", role="back", cap=c)
    if name in graphNames():
        others = [x for x in graphNames() if x != name]
        if graphNames()[0] == name and others:
            use(others[0])
        closeGraph(name)
    fromNetworkX(D, name)


def new_net(spec, name):
    return {"graph": name, "caps": dict(spec["caps"]), "flow": {k: 0 for k in spec["caps"]},
            "src": spec["src"], "snk": spec["snk"], "forced": [list(p) for p in spec["forced"]],
            "path": None, "neck": 0, "pushed": None, "cancel": [], "phase": "find", "value": 0,
            "history": [(0, 0)], "reach": None, "timer": None}


LINK = 10


def split_spec(src, snk):
    pos, caps = {}, {}
    for v, (px, py) in BASE_POS.items():
        pos[v + "i"] = (px - 20, py)
        pos[v + "o"] = (px + 20, py)
        caps[(v + "i", v + "o")] = 1                   # one path through each node, at most
    for u, v in BASE_EDGES:                            # links between nodes never limit: only the nodes do
        direct = {u, v} == {src, snk}                     # (except a direct link between the ends: one path)
        caps[(u + "o", v + "i")] = 1 if direct else LINK
        caps[(v + "o", u + "i")] = 1 if direct else LINK
    return {"pos": pos, "caps": caps, "src": src + "o", "snk": snk + "i", "forced": []}


# ---- the algorithm --------------------------------------------------------------------------------
def residual(net):
    """The residual network: {(u, v): (how much more can go from u to v, "fwd" or "back")}."""
    arcs = {}
    for (u, v), c in net["caps"].items():
        f = net["flow"][(u, v)]
        if c - f > 0:
            arcs[(u, v)] = (c - f, "fwd")
        if f > 0:
            arcs[(v, u)] = (f, "back")
    return arcs


def shortest_path(net, arcs):
    """Breadth-first search from the source in the residual network. Returns (path, reachable)."""
    out = {}
    for u, v in arcs:
        out.setdefault(u, []).append(v)
    came = {net["src"]: None}
    line = [net["src"]]
    while line:
        u = line.pop(0)
        for v in sorted(out.get(u, [])):
            if v not in came:
                came[v] = u
                line.append(v)
    if net["snk"] not in came:
        return None, set(came)
    path, v = [], net["snk"]
    while came[v] is not None:
        path.append((came[v], v))
        v = came[v]
    return path[::-1], set(came)


def step(net):
    """One phase: find an augmenting path, or push flow along the one found."""
    if net["phase"] == "done":
        return False
    arcs = residual(net)
    if net["phase"] == "find":
        net["pushed"], net["cancel"] = None, []
        if net["forced"]:
            path = net["forced"].pop(0)
        else:
            path, reach = shortest_path(net, arcs)
            if path is None:
                net["phase"], net["reach"], net["path"] = "done", reach, None
                draw_net(net)
                return False
        net["path"] = path
        net["neck"] = min(arcs[a][0] for a in path)
        net["phase"] = "push"
    else:
        neck = net["neck"]
        for u, v in net["path"]:
            if (u, v) in net["caps"] and net["caps"][(u, v)] - net["flow"][(u, v)] > 0:
                net["flow"][(u, v)] += neck
            else:
                net["flow"][(v, u)] -= neck                # a backward edge: cancel flow already sent
                net["cancel"].append((v, u))
        net["value"] += neck
        net["history"].append((len(net["history"]), net["value"]))
        net["pushed"], net["path"] = net["path"], None
        net["phase"] = "find"
    draw_net(net)
    return 1


def finish(net):
    stop(net)
    while step(net):
        pass


def cut_edges(net):
    reach = net["reach"] or set()
    return [k for k in net["caps"] if k[0] in reach and k[1] not in reach]


# ---- drawing --------------------------------------------------------------------------------------
view_mode = ["flow"]
SPLIT = [False]


def draw_net(net):
    if graphNames()[0] != net["graph"]:
        return
    res = view_mode[0] == "residual"
    path = set(net["path"] or [])
    pushed = set(net["pushed"] or [])
    cancel = set(net["cancel"])
    done = net["phase"] == "done"
    reach = net["reach"] or set()
    cut = set(cut_edges(net)) if done else set()
    top = 1 if SPLIT[0] else max(net["caps"].values())
    for n in g.nodes:
        n.labelpos = "inside"
        n.labelvisible = true
        n.strokecolor = "60,60,60"
        if SPLIT[0]:
            base = n.name[:-1]
            n.width = n.height = 26
            n.label = base[1:] if n.name.endswith("i") else ""
            n.color = "180,195,220" if n.name.endswith("i") else "120,140,175"
        else:
            n.width = n.height = 40
            n.label = n.name
            n.color = "180,195,220"
        if n.name == net["src"] or (SPLIT[0] and n.name == net["src"][:-1] + "i"):
            n.color = "60,170,90"
        if n.name == net["snk"] or (SPLIT[0] and n.name == net["snk"][:-1] + "o"):
            n.color = "220,70,60"
    for e in g.edges:
        u, v = e.node1.name, e.node2.name
        key = (u, v) if e.role == "fwd" else (v, u)
        c, f = net["caps"][key], net["flow"][key]
        e.labelvisible = true
        e.linestyle = "solid"
        e.labelsize = 1.3
        if e.role == "fwd":
            if res:
                e.visible, e.label, e.arc = c - f > 0, str(c - f), 14
                e.color, e.width = "120,150,200", 1.5 + 4 * (c - f) / top
            else:
                e.visible, e.arc = true, 0.01             # (straight: a tiny arc overrides the bend away from the hidden twin)
                e.label = f"{f}/{c}" if not SPLIT[0] else ""
                e.width = 1.5 + 6 * f / top
                e.color = "60,120,220" if f > 0 else "160,160,160,140"
        else:
            e.visible = res and f > 0
            e.label, e.arc = str(f), 14
            e.color, e.width = "150,90,200", 1.5 + 4 * f / top
        if SPLIT[0] and not res:
            e.labelvisible = false
        # the path being followed, in the residual network (or on the edge whose flow it cancels)
        if (u, v) in path and ((e.role == "back" and res) or (u, v) in net["caps"]):
            if (e.role == "fwd" and net["caps"][(u, v)] - net["flow"][(u, v)] > 0) or e.role == "back":
                e.visible, e.color, e.width, e.linestyle = true, "245,150,30", 5, "flow"
        if not res and e.role == "fwd" and (v, u) in path:
            e.color, e.width, e.linestyle = "170,70,220", 5, "dashed"       # flow about to be cancelled
        if e.role == "fwd" and key in pushed and not res:
            e.color, e.width = "40,190,90", 1.5 + 6 * f / top + 2
        if e.role == "fwd" and key in cancel and not res:
            e.color, e.width, e.linestyle = "170,70,220", 4, "dashed"
        if e.role == "fwd" and key in cut:
            e.visible, e.color, e.width, e.linestyle = true, "230,40,40", 5, "dashed"
            e.label = str(c) if res else f"{f}/{c}"
            e.labelvisible = not SPLIT[0]
    for (u, v) in path:
        for name in (u, v):
            nd = g.getNodeByName(name)
            nd.strokecolor = "245,150,30"
            nd.width, nd.height = nd.width + 10, nd.height + 10
    if done:
        for n in g.nodes:                                 # the two sides of the cut, by colour
            if n.name not in (net["src"], net["snk"]) and n.color not in ("60,170,90", "220,70,60"):
                n.color = "150,215,165" if n.name in reach else "235,160,150"
        if SPLIT[0]:
            for a, b in cut:
                if a[:-1] == b[:-1]:                              # an inside edge: this node is in the cut
                    for name in (a, b):
                        nd = g.getNodeByName(name)
                        nd.strokecolor, nd.width, nd.height = "230,40,40", 36, 36


def chips(path):
    if not path:
        return ""
    names = [path[0][0]] + [v for _, v in path]
    if SPLIT[0]:
        out = []
        for x in names:
            if not out or out[-1][0] != x[:-1]:
                out.append((x[:-1], x))
        return " → ".join(linkTo(g.getNodeByName(x), text=b[1:]) for b, x in out)
    return " → ".join(linkTo(g.getNodeByName(x)) for x in names)


def text(net):
    if graphNames()[0] != net["graph"]:
        return ""
    k = len(net["history"]) - 1
    if net["phase"] == "done":
        cut = cut_edges(net)
        total = sum(net["caps"][c] for c in cut)
        if SPLIT[0]:
            return ""
        return (f"**No augmenting path is left**, after {k} path{'s' if k != 1 else ''}. Maximum flow: **{net['value']}**.\n\n"
                "The nodes the source can still reach in the residual network (light green) and the rest (pink) "
                "split the network. Every edge from the green side to the red one is full, so it is a cut: "
                f"{' + '.join(str(net['caps'][c]) for c in cut)} = **{total}**, the same as the flow. No cut "
                "can be smaller than any flow, so both are optimal: **max-flow = min-cut**.")
    arcs = residual(net)
    if net["phase"] == "push":
        back = [(u, v) for u, v in net["path"] if arcs[(u, v)][1] == "back"]
        line = (f"**Augmenting path {k + 1}:** {chips(net['path'])}. Its tightest edge leaves room for "
                f"**{net['neck']}** more unit{'s' if net['neck'] != 1 else ''}, so that is what it can carry.")
        if back:
            u, v = back[0]
            line += (f"\n\nIt goes **backwards** from {u} to {v} (purple, dashed): there is no edge {u}→{v}, "
                     f"but sending flow that way means taking back flow already sent along {v}→{u}. "
                     "That is how the algorithm undoes an earlier bad choice.")
        return line + "\n\n*Step* to push it."
    if net["pushed"]:
        line = (f"Pushed **{net['neck']}** along path {k} (green). Flow so far: **{net['value']}**.")
        if net["cancel"]:
            u, v = net["cancel"][0]
            line += f" It **cancelled** {net['neck']} units on {u}→{v}, which now carries {net['flow'][(u, v)]}."
        return line
    if net["forced"]:
        p = net["forced"][0]
        return ("Suppose the first path chosen is " + chips(p) + ", straight through the middle. "
                "*Step* to see what that does, then keep going.")
    return ("Each edge shows **flow / capacity**. *Step* finds an augmenting path from S to T "
            "(breadth-first, so the shortest), then pushes flow along it. *Run* repeats until no path is left.")


# ---- tab 1: the algorithm ----------------------------------------------------------------------------
NETS = {}


def load(choice):
    if "flow" in NETS:
        stop(NETS["flow"])
    spec = CHOICES[choice]
    to_graph(spec["pos"], spec["caps"], "network")
    NETS["flow"] = new_net(spec, "network")
    SPLIT[0] = False
    draw_net(NETS["flow"])
    center()


def stop(net):
    if net.get("timer") is not None:
        net["timer"].stop()
        net["timer"] = None


def run(net):
    stop(net)
    net["timer"] = everyPaced(lambda: step(net), slow=1.3, fast=0.5, ramp=2)


def set_view(v):
    view_mode[0] = "residual" if v.startswith("Residual") else "flow"
    current = NETS["split"] if SPLIT[0] else NETS["flow"]
    draw_net(current)


def flow_chart():
    net = NETS["split"] if SPLIT[0] else NETS["flow"]
    if graphNames()[0] != net["graph"]:
        return None
    pts = net["history"]
    if len(pts) < 2:
        return None
    data = {"flow so far": pts}
    if net["phase"] == "done":
        total = sum(net["caps"][c] for c in cut_edges(net))
        data["minimum cut"] = [(0, total), (max(1, len(pts) - 1), total)]
    return plotLine(data, title="Flow after each augmenting path", xlabel="augmenting paths", ylabel="flow",
                    dots=true)


# ---- simulate: shortest augmenting paths against any path ----------------------------------------------
sim = {"rows": []}


def count_paths(caps, src, snk, how, rnd):
    net = {"caps": caps, "flow": {k: 0 for k in caps}, "src": src, "snk": snk}
    k = 0
    while True:
        arcs = residual(net)
        if how == "bfs":
            path, _ = shortest_path(net, arcs)
        else:
            out = {}
            for u, v in arcs:
                out.setdefault(u, []).append(v)
            for u in out:
                rnd.shuffle(out[u])
            came, todo, path = {src: None}, [src], None
            while todo:                                 # depth-first: any path at all
                u = todo.pop()
                if u == snk:
                    break
                for v in out.get(u, []):
                    if v not in came:
                        came[v] = u
                        todo.append(v)
            if snk in came:
                path, v = [], snk
                while came[v] is not None:
                    path.append((came[v], v))
                    v = came[v]
                path = path[::-1]
        if path is None:
            return k
        neck = min(arcs[a][0] for a in path)
        for u, v in path:
            if (u, v) in caps and caps[(u, v)] - net["flow"][(u, v)] > 0:
                net["flow"][(u, v)] += neck
            else:
                net["flow"][(v, u)] -= neck
        k += 1


def simulate():
    rnd = random.Random(4)
    rows = []
    for n in (10, 20, 40, 80):
        b, d = [], []
        for _ in range(6):
            G = nx.gnp_random_graph(n, 4 / n, seed=rnd.randrange(10 ** 6), directed=True)
            caps = {}
            for u, v in G.edges():
                if (v, u) not in caps:
                    caps[(u, v)] = rnd.randint(1, 60)
            b.append(count_paths(caps, 0, n - 1, "bfs", rnd))
            d.append(count_paths(caps, 0, n - 1, "dfs", rnd))
        rows.append((n, sum(b) / len(b), sum(d) / len(d)))
    sim["rows"] = rows


def sim_chart():
    if not sim["rows"]:
        return None
    return plotLine({"shortest path first (BFS)": [(n, b) for n, b, _ in sim["rows"]],
                     "any path (DFS)": [(n, d) for n, _, d in sim["rows"]]},
                    title="Augmenting paths needed, random networks", xlabel="nodes", ylabel="paths", dots=true)


def sim_text():
    if not sim["rows"]:
        return ("**Does the choice of path matter?** Any augmenting path gives the right answer, but taking "
                "the *shortest* one (Edmonds–Karp) bounds the number of paths by the network's size, while "
                "arbitrary paths can need as many as the flow is large.")
    n, b, d = sim["rows"][-1]
    return (f"Random directed networks, capacities 1–60, 6 of each size. At n = {n}: **{b:.1f}** paths when "
            f"taking the shortest, **{d:.1f}** when taking any (depth-first). Each path costs O(m) to find.")


# ---- tab 2: node-independent paths -------------------------------------------------------------------
ends = {"a": "v0", "b": "v9", "next": "a"}


def load_split():
    spec = split_spec(ends["a"], ends["b"])
    to_graph(spec["pos"], spec["caps"], "split")
    NETS["split"] = new_net(spec, "split")


def split_click(n):
    base = n.name[:-1]
    if ends["next"] == "a":
        ends["a"], ends["next"] = base, "b"
    elif base != ends["a"]:
        ends["b"], ends["next"] = base, "a"
    else:
        return
    stop(NETS["split"])
    NETS["split"] = new_net(split_spec(ends["a"], ends["b"]), "split")
    draw_net(NETS["split"])


def split_paths(net):
    """Follow the flow from the source: one path per unit."""
    left = {k: f for k, f in net["flow"].items() if f > 0}
    paths = []
    while True:
        u, path = net["src"], [net["src"]]
        while u != net["snk"]:
            nxt = next((k for k in left if k[0] == u and left[k] > 0), None)
            if nxt is None:
                return paths
            left[nxt] -= 1
            u = nxt[1]
            path.append(u)
        paths.append(path)


def split_text():
    net = NETS.get("split")
    if net is None or graphNames()[0] != "split":
        return ""
    a, b = ends["a"], ends["b"]
    head = (f"From **{a[1:]}** (green) to **{b[1:]}** (red). Each node is split into an *in* half (labelled) "
            "and an *out* half, joined by an edge of capacity 1, so at most one path can pass through a node. "
            "Every edge of the original becomes two arrows, out-half to in-half, each way. "
            "*Click a node, then another,* to choose new ends.")
    if net["phase"] != "done":
        return head + "\n\n" + text(net).replace("from S to T", "") if net["phase"] == "push" or net["pushed"] else head
    paths = split_paths(net)
    rows = []
    for p in paths:
        seen = []
        for x in p:
            if not seen or seen[-1][0] != x[:-1]:
                seen.append((x[:-1], x))
        rows.append("- " + " → ".join(linkTo(g.getNodeByName(x), text=bb[1:]) for bb, x in seen))
    cut = [k[0][:-1] for k in cut_edges(net) if k[0][:-1] == k[1][:-1]]
    if BASE.has_edge(a, b) or not cut:
        check = "They are neighbours, so no set of nodes can separate them; the direct edge is one of the paths."
    else:
        check = (f"networkx's node connectivity agrees: **{nx.node_connectivity(BASE, a, b)}**. The cut found "
                 f"crosses the inside edges of nodes **{', '.join(c[1:] for c in cut)}** (big, red outline): remove those "
                 "nodes and the two ends are cut apart (Menger's theorem).")
    return (head + f"\n\n**Maximum flow {net['value']}**, so **{net['value']} node-independent paths**:\n\n"
            + "\n".join(rows) + "\n\n" + check)


# ---- tabs and clicks ---------------------------------------------------------------------------------------
def switch(title):
    for net in NETS.values():
        stop(net)
    SPLIT[0] = title.startswith("Node")
    use("split" if SPLIT[0] else "network")
    draw_net(NETS["split"] if SPLIT[0] else NETS["flow"])
    center()


def click(n):
    if SPLIT[0]:
        split_click(n)


load_split()
load("A small network")
closeGraph("main") if "main" in graphNames() else None
graphevents.clickNode = click
constantLabelSize(size=14)
ui.title("Maximum flow by augmenting paths", "Networks, Section 8.7")
ui.layout(
    right=Column(
        Markdown("""### Augmenting paths
Push flow along a path with room to spare; repeat until there is none.
Green: source; red: sink."""),
        Dropdown(["Flow on each edge (flow / capacity)", "Residual network (room left, each way)"], label="Show",
                 onChange=set_view),
        Tabs(
            Tab("The algorithm",
                Dropdown(list(CHOICES), label="Network", onChange=load),
                Row(Button("Step", onClick=lambda: step(NETS["flow"])),
                    Button("Run", onClick=lambda: run(NETS["flow"])),
                    Button("Reset", onClick=lambda: load([k for k, v in CHOICES.items()
                                                          if v["caps"] == NETS["flow"]["caps"]][0]))),
                Markdown(lambda: text(NETS["flow"])),
                Chart(flow_chart)),
            Tab("Which path?",
                Markdown(sim_text),
                Button("Simulate: shortest paths against any paths", onClick=lambda: simulate()),
                Chart(sim_chart)),
            Tab("Node-independent paths",
                Row(Button("Next step", onClick=lambda: step(NETS["split"])),
                    Button("Play", onClick=lambda: run(NETS["split"])),
                    Button("All at once", onClick=lambda: finish(NETS["split"]))),
                Markdown(split_text),
                Chart(flow_chart)),
            onChange=switch)),
    sizes={"right": 400},
)
ui.toolbar(Action("tool:select"), Action("fit"), Action("png"), "|", Action("source", "How this is built"))
ui.statusbar(Label(lambda: f"{graphNames()[0]}: {len(g.nodes)} nodes"))
center()
