# Two diseases, and complex contagion  (Newman, Networks, Sections 16.1.8-16.1.9)
# Two diseases can help each other: someone already ill with one is easier
# to infect with the other. Then the two spread together, and the outbreak
# size can jump suddenly, rather than grow smoothly, as transmission rises.
# Ideas and behaviours often spread differently from diseases: people adopt
# them only after hearing from several contacts (complex contagion). Then
# clustering helps, because friends of friends reinforce each other, and
# random shortcuts, which speed up a disease, no longer help at all.
#
# Both processes are run by small step functions below. Networks are built
# by this script with seeded random numbers, so they are the same everywhere,
# and nodes keep their places while things spread.

import math
import random

# ---- shared ---------------------------------------------------------------------------------------
A_COL, B_COL, AB_COL, NONE_COL = "235,70,60", "60,125,235", "155,70,205", "205,210,220"
ADOPT, ADOPT_LINE, NOT_YET = "250,165,40", "120,60,0", "200,205,215"
mode = ["Two diseases"]
co = {"shown": False, "adj": {}, "A": {}, "B": {}, "freshA": set(), "freshB": set(), "edgesA": set(), "edgesB": set(),
      "gen": 0, "curve": [], "timer": None, "sweep": [], "sweeptimer": None, "seed": None, "start": None}
cx = {"adj": {}, "adopted": {}, "fresh": set(), "edges": set(), "step": 0, "curve": [], "timer": None,
      "sweep": [], "sweeptimer": None, "start": 0}


def poisson_network(n, c, rnd):
    """Configuration-model style random network with Poisson(c) degrees: {i: set of neighbours}."""
    stubs = []
    for i in range(n):
        L, k, p = math.exp(-c), 0, 1.0
        while True:
            p *= rnd.random()
            if p <= L:
                break
            k += 1
        stubs += [i] * k
    rnd.shuffle(stubs)
    adj = {i: set() for i in range(n)}
    for j in range(0, len(stubs) - 1, 2):
        a, b = stubs[j], stubs[j + 1]
        if a != b:
            adj[a].add(b)
            adj[b].add(a)
    return adj


# ---- two diseases -----------------------------------------------------------------------------------
CO_N, CO_C = 300, 4.0


def build_coinfection():
    rnd = random.Random(11)
    adj = poisson_network(CO_N, CO_C, rnd)
    co["adj"] = adj
    newGraph("two diseases")
    nodes = [addNode(f"q{i}") for i in range(CO_N)]
    for i, ns in adj.items():
        for j in ns:
            if i < j:
                addEdge(nodes[i], nodes[j])
    frLayout()
    binPackLayout(false)
    noverlapLayout(margin=3)
    center(g.nodes)
    co["seed"] = max(adj, key=lambda i: (len(adj[i]) == 4, -i))      # a typical node to start from


def co_reset():
    co_stop()
    co.update(A={i: False for i in co["adj"]}, B={i: False for i in co["adj"]}, freshA=set(), freshB=set(),
              edgesA=set(), edgesB=set(), gen=0, curve=[])
    co_paint()


def co_start(seed=None):
    co_reset()
    if not co["shown"]:
        co["shown"] = True
        for k in range(1, 60):                   # a first run that takes off (later ones are left to chance)
            r = random.Random(k)
            A = {i: False for i in co["adj"]}
            B = {i: False for i in co["adj"]}
            s0 = co["seed"] if seed is None else seed
            A[s0] = B[s0] = True
            fA, fB = {s0}, {s0}
            while fA or fB:
                fA, fB, _ea, _eb = co_generation(r, co["adj"], A, B, fA, fB, p_sl.value)
            if sum(1 for i in co["adj"] if A[i] and B[i]) > 0.3 * CO_N:   # both spread, together
                co_rnd.seed(k)
                break
    s_ = co["seed"] if seed is None else seed
    co["start"] = s_
    co["A"][s_] = co["B"][s_] = True
    co["freshA"], co["freshB"] = {s_}, {s_}
    co["curve"].append((0, 1, 1, 1))
    co_paint()


def chance(other_has, p):
    """The chance of passing a disease along one contact: p, or q if the other disease is there."""
    return q_sl.value if (helping[0] and other_has) else p


def co_generation(rnd, adj, A, B, freshA, freshB, p):
    """One generation of both cascades: each newly infected node gets one try per contact."""
    newA, newB, eA, eB = set(), set(), set(), set()
    for v in freshA:
        for u in adj[v]:
            if not A[u] and u not in newA and rnd.random() < chance(B[u], p):
                newA.add(u)
                eA.add(frozenset((u, v)))
    for v in freshB:
        for u in adj[v]:
            if not B[u] and u not in newB and rnd.random() < chance(A[u], p):
                newB.add(u)
                eB.add(frozenset((u, v)))
    for u in newA:
        A[u] = True
    for u in newB:
        B[u] = True
    return newA, newB, eA, eB


co_rnd = random.Random(1)


def co_step():
    if not co["freshA"] and not co["freshB"]:
        co["edgesA"] = co["edgesB"] = set()
        co_paint()
        co_btn.text = "Start both diseases"
        return False
    newA, newB, eA, eB = co_generation(co_rnd, co["adj"], co["A"], co["B"], co["freshA"], co["freshB"],
                                       p_sl.value)
    co["freshA"], co["freshB"], co["edgesA"], co["edgesB"] = newA, newB, eA, eB
    co["gen"] += 1
    a_ = sum(co["A"].values())
    b_ = sum(co["B"].values())
    both = sum(1 for i in co["adj"] if co["A"][i] and co["B"][i])
    co["curve"].append((co["gen"], a_, b_, both))
    co_paint()
    if not newA and not newB:
        co_btn.text = "Start both diseases"
        return False
    return True


def co_paint():
    if not graphNames() or graphNames()[0] != "two diseases":
        return
    for v in g.nodes:
        i = int(v.name[1:])
        a, b = co["A"].get(i, False), co["B"].get(i, False)
        new = i in co["freshA"] or i in co["freshB"]
        if a and b:
            v.color, v.strokecolor, v.strokewidth = AB_COL, "50,10,70", 2.5
            v.width = v.height = 15
        elif a:
            v.color, v.strokecolor, v.strokewidth = A_COL, "90,10,10", 1.2
            v.width = v.height = 11
        elif b:
            v.color, v.strokecolor, v.strokewidth = B_COL, "10,30,90", 1.2
            v.width = v.height = 11
        else:
            v.color, v.strokecolor, v.strokewidth = NONE_COL, "120,120,130", 0.4
            v.width = v.height = 8
        if new and co["gen"] > 0:
            v.width = v.height = v.width + 6
        if i == co["start"]:
            v.strokecolor, v.strokewidth = "255,220,60", 3.5
        v.labelvisible = false
    for e in g.edges:
        key = frozenset((int(e.node1.name[1:]), int(e.node2.name[1:])))
        if key in co["edgesA"] and key in co["edgesB"]:
            e.color, e.width, e.linestyle = AB_COL, 3.2, "flow"
        elif key in co["edgesA"]:
            e.color, e.width, e.linestyle = A_COL, 3, "flow"
        elif key in co["edgesB"]:
            e.color, e.width, e.linestyle = B_COL, 3, "flow"
        else:
            e.color, e.width, e.linestyle = "150,150,165,100", 0.8, "solid"


def co_go():
    if co["timer"] is not None and co["timer"].running:
        co_stop()
        co_btn.text = "Continue"
        return
    if co_btn.text != "Continue" or (not co["freshA"] and not co["freshB"]):
        co_start()
    co["timer"] = everyPaced(co_step, slow=0.9, fast=0.3, ramp=3)
    co_btn.text = "Pause"


def co_stop():
    for key in ("timer", "sweeptimer"):
        if co[key] is not None:
            co[key].stop()
            co[key] = None


def co_to_end():
    co_stop()
    if not co["freshA"] and not co["freshB"]:
        co_start()
    for _ in range(500):
        if co_step() is False:
            break


def co_text():
    p = p_sl.value
    how = (f"someone who already has the other disease catches it with probability **q = {q_sl.value:.2f}**"
           if helping[0] else "the two diseases ignore each other")
    txt = (f"Two diseases, red and blue, start from the same person (yellow ring) in a random network of "
           f"{CO_N} people with mean degree {CO_C:g}. Each newly infected person gets one try at each contact: "
           f"the chance of passing a disease on is **p = {p:.2f}**, and {how}. People with both are purple and "
           "outlined. The edges a disease crossed this generation flash in its colour.")
    if co["curve"]:
        g_, a_, b_, both = co["curve"][-1]
        txt += (f"\n\nGeneration **{g_}**: red reached **{a_}**, blue **{b_}**, both **{both}** "
                f"({both / CO_N:.0%} of everyone).")
        if not co["freshA"] and not co["freshB"] and g_ > 0:
            txt += " Both have stopped."
    txt += ("\n\nAlone, each disease takes off only when p is above about 1/c = "
            f"{1 / CO_C:.2f}. When they help each other, being ill with one makes the other easier, and once "
            "both are spreading they keep pushing each other: the outbreak can jump from small to most of the "
            "network over a narrow range of p. Try p near 0.15–0.25 with and without help.")
    return txt


def co_chart():
    if mode[0] != "Two diseases" or not co["curve"]:
        return None
    # in this order the palette draws each disease in its own colour
    return plotLine({"blue": [(g_, b_) for g_, a_, b_, bo in co["curve"]],
                     "red": [(g_, a_) for g_, a_, b_, bo in co["curve"]],
                     "both": [(g_, bo) for g_, a_, b_, bo in co["curve"]]},
                    title="People infected, generation by generation", xlabel="generation", ylabel="people",
                    dots=true)


# simulate: final size of one disease as p rises, alone and helped
PS = [0.1, 0.13, 0.16, 0.18, 0.2, 0.22, 0.24, 0.26, 0.28, 0.3, 0.35, 0.4, 0.5]


def co_sweep_start():
    co_stop()
    co["sweep"] = []
    co["sweeptimer"] = everyPaced(co_sweep_step, steps=len(PS), slow=0.5, fast=0.15, ramp=2)


def co_final(adj, p, helped, rnd):
    A = {i: False for i in adj}
    B = {i: False for i in adj}
    s_ = rnd.choice(sorted(adj))
    A[s_] = B[s_] = True
    fA, fB = {s_}, {s_}
    keep = helping[0]
    helping[0] = helped
    while fA or fB:
        fA, fB, _ea, _eb = co_generation(rnd, adj, A, B, fA, fB, p)
    helping[0] = keep
    return sum(A.values()) / len(adj)


def co_sweep_step():
    p = PS[len(co["sweep"])]
    rnd = random.Random(40 + len(co["sweep"]))
    big = poisson_network(1500, CO_C, random.Random(77))
    alone = [co_final(big, p, False, rnd) for _ in range(24)]
    helped = [co_final(big, p, True, rnd) for _ in range(24)]
    co["sweep"].append((p, max(alone), max(helped), sum(alone) / 24, sum(helped) / 24))
    return len(PS) - len(co["sweep"])


def theory_alone(p):
    """One disease alone: bond percolation on a Poisson network, S = 1 - e^(-c p S)."""
    s_ = 0.9
    for _ in range(400):
        s_ = 1 - math.exp(-CO_C * p * s_)
    return s_ if s_ > 1e-6 else 0.0


def co_sweep_chart():
    if mode[0] != "Simulate the jump":
        return None
    series = {"alone, theory": [(p / 100, theory_alone(p / 100)) for p in range(5, 61)]}
    if co["sweep"]:
        series["alone"] = [(p, a) for p, a, h, ma, mh in co["sweep"]]
        series["helping each other"] = [(p, h) for p, a, h, ma, mh in co["sweep"]]
    return plotLine(series, title="How far the red disease gets", xlabel="p, chance per contact",
                    ylabel="share infected", dashed=["alone, theory"], highlight=["helping each other", "alone"],
                    yrange=(0, 1))


def co_sweep_text():
    txt = (f"On a random network of 1,500 people (mean degree {CO_C:g}), each p is tried 24 times with the "
           f"diseases alone and 24 times helping each other (q = {q_sl.value:.2f}); the chart shows the largest "
           "outbreak of red. Alone, it grows smoothly from p = 1/c, as the dashed theory says. Helped, it "
           "takes off at a lower p and jumps.")
    if co["sweep"]:
        rows = ["| p | alone | helped |", "|---|---|---|"]
        rows += [f"| {p:.2f} | {a:.0%} | {h:.0%} |" for p, a, h, ma, mh in co["sweep"]]
        txt += "\n\n" + "\n".join(rows)
    return txt


# ---- complex contagion ------------------------------------------------------------------------------------
CX_N, CX_K = 150, 6
REWIRES = {"Clustered ring (no shortcuts)": 0.0, "A few shortcuts (5% rewired)": 0.05,
           "Rewired at random (100%)": 1.0}


def ring_network(n, k, p, rnd):
    """A ring where each node links to its k nearest neighbours; each link's far end is then moved to a
    random node with probability p (no self-links or repeats). {i: set of neighbours}."""
    adj = {i: set() for i in range(n)}
    edges = [(i, (i + j) % n) for i in range(n) for j in range(1, k // 2 + 1)]
    for a, b in edges:
        adj[a].add(b)
        adj[b].add(a)
    for a, b in edges:
        if rnd.random() < p:
            choices = [c for c in range(n) if c != a and c not in adj[a]]
            if choices and len(adj[b]) > 1:
                c = rnd.choice(choices)
                adj[a].discard(b)
                adj[b].discard(a)
                adj[a].add(c)
                adj[c].add(a)
    return adj


def build_ring(label):
    p = REWIRES[label]
    adj = ring_network(CX_N, CX_K, p, random.Random(4))
    cx["adj"] = adj
    if "ideas" in graphNames():
        use("ideas")
        remove(list(g.nodes))
    else:
        newGraph("ideas")
    nodes = []
    for i in range(CX_N):
        ang = 2 * math.pi * i / CX_N
        nodes.append(addNode(f"w{i}", x=500 + 480 * math.cos(ang), y=500 + 480 * math.sin(ang)))
    for i, ns in adj.items():
        for j in ns:
            if i < j:
                e = addEdge(nodes[i], nodes[j])
                d = (j - i) % CX_N
                if d <= CX_K // 2:                 # ring links: bow outward, more for longer reach
                    e.arc = -28 * d
                elif (i - j) % CX_N <= CX_K // 2:
                    e.arc = 28 * ((i - j) % CX_N)
    center(g.nodes)
    cx_reset()


def cx_reset():
    cx_stop()
    cx.update(adopted={i: False for i in cx["adj"]}, fresh=set(), edges=set(), step=0, curve=[])
    cx_paint()


def cx_seed(start=None):
    cx_reset()
    s_ = cx["start"] if start is None else start
    cx["start"] = s_
    for d in range(4):                          # four neighbours along the ring adopt first
        cx["adopted"][(s_ + d) % CX_N] = True
    cx["fresh"] = {(s_ + d) % CX_N for d in range(4)}
    cx["curve"].append((0, 4))
    cx_paint()


def cx_step():
    m = int(m_sl.value)
    adj, ad = cx["adj"], cx["adopted"]
    new, edges = [], set()
    for v in adj:
        if not ad[v]:
            told = [u for u in adj[v] if ad[u]]
            if len(told) >= m:
                new.append(v)
                edges |= {frozenset((u, v)) for u in told}
    for v in new:
        ad[v] = True
    cx["fresh"], cx["edges"] = set(new), edges
    cx["step"] += 1
    total = sum(ad.values())
    cx["curve"].append((cx["step"], total))
    cx_paint()
    if not new or total == CX_N:
        cx_btn.text = "Spread the idea"
        if not new:
            cx["fresh"], cx["edges"] = set(), set()
            cx_paint()
        return False
    return True


def cx_paint():
    if not graphNames() or graphNames()[0] != "ideas":
        return
    for v in g.nodes:
        i = int(v.name[1:])
        if cx["adopted"].get(i, False):
            v.color, v.strokecolor, v.strokewidth = ADOPT, ADOPT_LINE, 2 if i in cx["fresh"] else 1
            v.width = v.height = 20 if i in cx["fresh"] and cx["step"] > 0 else 12
        else:
            v.color, v.strokecolor, v.strokewidth = NOT_YET, "110,110,120", 0.5
            v.width = v.height = 9
        v.labelvisible = false
    for e in g.edges:
        key = frozenset((int(e.node1.name[1:]), int(e.node2.name[1:])))
        a, b = int(e.node1.name[1:]), int(e.node2.name[1:])
        ring = min((a - b) % CX_N, (b - a) % CX_N) <= CX_K // 2
        if key in cx["edges"]:
            e.color, e.width, e.linestyle = "240,120,20", 3.2, "flow"
        else:
            e.color = "150,150,165,140" if ring else "120,170,230,170"   # shortcuts in blue
            e.width, e.linestyle = (1.0 if ring else 1.4), "solid"


def cx_go():
    if cx["timer"] is not None and cx["timer"].running:
        cx_stop()
        cx_btn.text = "Continue"
        return
    if cx_btn.text != "Continue" or not cx["curve"]:
        cx_seed()
    cx["timer"] = everyPaced(cx_step, slow=0.9, fast=0.3, ramp=3)
    cx_btn.text = "Pause"


def cx_stop():
    for key in ("timer", "sweeptimer"):
        if cx[key] is not None:
            cx[key].stop()
            cx[key] = None


def cx_text():
    m = int(m_sl.value)
    rule = ("one contact who has it is enough (simple contagion, like a disease)" if m == 1 else
            f"a person adopts only after **{m}** of their contacts have")
    txt = (f"{CX_N} people on a ring, each knowing their {CX_K} nearest neighbours; blue lines are shortcuts "
           f"made by rewiring. Four neighbours start with an idea (orange); {rule}. Each step, the edges "
           "from the people who convinced a new adopter flash.")
    if cx["curve"]:
        s_, tot = cx["curve"][-1]
        txt += f"\n\nStep **{s_}**: **{tot}** of {CX_N} have adopted."
        if cx["timer"] is None or not cx["timer"].running:
            if tot == CX_N:
                txt += f" Everyone, in {s_} steps."
            elif s_ > 0 and not cx["fresh"]:
                txt += " It has **stalled**: nobody else has enough adopting contacts."
    txt += ("\n\nOn the clustered ring, neighbours of adopters share several adopting contacts, so the idea "
            "creeps around the ring. Shortcuts speed up a simple contagion, but with a threshold of 2 they "
            "lead to strangers who have only one adopting contact, and the idea stalls. *Click a person* to "
            "start there.")
    return txt


def cx_chart():
    if mode[0] != "Complex contagion" or not cx["curve"]:
        return None
    return plotLine({"adopted": cx["curve"]}, title="People who have adopted", xlabel="step", ylabel="people",
                    dots=true, yrange=(0, CX_N))


SWEEP_P = [0.001, 0.003, 0.01, 0.03, 0.1, 0.3, 1.0]


def cx_sweep_start():
    cx_stop()
    cx["sweep"] = []
    cx["sweeptimer"] = everyPaced(cx_sweep_step, steps=len(SWEEP_P), slow=0.5, fast=0.2, ramp=2)


def run_threshold(adj, m, start):
    n = len(adj)
    ad = {i: False for i in adj}
    for d in range(4):
        ad[(start + d) % n] = True
    steps, half = 0, None
    while True:
        new = [v for v in adj if not ad[v] and sum(1 for u in adj[v] if ad[u]) >= m]
        if not new:
            break
        for v in new:
            ad[v] = True
        steps += 1
        if half is None and sum(ad.values()) >= 0.9 * n:
            half = steps
    return sum(ad.values()) / n, half


def cx_sweep_step():
    p = SWEEP_P[len(cx["sweep"])]
    rows = []
    for rep in range(4):
        adj = ring_network(400, CX_K, p, random.Random(200 + rep))
        f1, t1 = run_threshold(adj, 1, 0)
        f2, t2 = run_threshold(adj, 2, 0)
        rows.append((f1, t1, f2))
    times = [t for _f, t, _g in rows if t is not None]
    cx["sweep"].append((p, sum(r[2] for r in rows) / 4, sum(times) / len(times) if times else None))
    return len(SWEEP_P) - len(cx["sweep"])


def cx_sweep_text():
    txt = ("Rings of 400 people (each knowing 6 neighbours), rewired a share p, four tries each. **Simple "
           "contagion** (one contact is enough) always reaches everyone, and shortcuts make it much faster. "
           "**Complex contagion** (two contacts needed) needs the ring's clustering: as shortcuts replace "
           "neighbours it stops reaching everyone.")
    if cx["sweep"]:
        rows = ["| p rewired | steps to 90%, simple | share reached, two contacts |", "|---|---|---|"]
        rows += [f"| {p:g} | {('–' if t is None else f'{t:.0f}')} | {f2:.0%} |" for p, f2, t in cx["sweep"]]
        txt += "\n\n" + "\n".join(rows)
    return txt


def cx_sweep_chart():
    if mode[0] != "Shortcuts help or hurt" or not cx["sweep"]:
        return None
    return plotLine({"two contacts: share reached": [(p, f2) for p, f2, t in cx["sweep"]],
                     "one contact: steps to 90% ÷ 100": [(p, t / 100) for p, f2, t in cx["sweep"] if t]},
                    title="Shortcuts help a disease, hurt an idea", xlabel="share of links rewired",
                    ylabel="share / steps ÷ 100", logX=true, highlight=["two contacts: share reached"],
                    yrange=(0, 1.05))


# ---- wiring -----------------------------------------------------------------------------------------------
helping = [true]


def set_help(v):
    helping[0] = v.startswith("Helping")


def pick_ring(label):
    cx_stop()
    build_ring(label)
    constantLabelSize(size=14)
    cx_btn.text = "Spread the idea"


def click_node(v):
    if v.name.startswith("w"):
        cx_btn.text = "Spread the idea"
        cx_seed(int(v.name[1:]))
    elif v.name.startswith("q"):
        co_start(int(v.name[1:]))


def switch(title):
    mode[0] = title
    co_stop()
    cx_stop()
    if title in ("Two diseases", "Simulate the jump"):
        if graphNames()[0] != "two diseases":
            use("two diseases")
        co_paint()
    else:
        if graphNames()[0] != "ideas":
            use("ideas")
        cx_paint()
    constantLabelSize(size=14)
    co_btn.text = "Start both diseases"
    cx_btn.text = "Spread the idea"


co_btn = Button("Start both diseases", onClick=lambda: co_go())
cx_btn = Button("Spread the idea", onClick=lambda: cx_go())
p_sl = Slider(0.05, 0.6, 0.3, 0.01, label="p, chance per contact")
q_sl = Slider(0, 1, 0.9, 0.05, label="q, when the other is there")
m_sl = Slider(1, 3, 2, 1, label="contacts needed to adopt")
build_ring("Clustered ring (no shortcuts)")
build_coinfection()
closeGraph("main") if "main" in graphNames() else None
co_reset()
graphevents.clickNode = click_node
constantLabelSize(size=14)
ui.title("Two diseases, and complex contagion", "Networks, Sections 16.1.8–16.1.9")
ui.layout(
    right=Column(
        Tabs(
            Tab("Two diseases",
                Dropdown(["Helping each other", "Independent"], label="The diseases", onChange=set_help),
                p_sl, q_sl,
                Row(co_btn, Button("To the end", onClick=lambda: co_to_end())),
                Markdown(co_text), Chart(co_chart)),
            Tab("Simulate the jump",
                Button("Simulate: alone and helped", onClick=lambda: co_sweep_start()),
                Chart(co_sweep_chart), Markdown(co_sweep_text)),
            Tab("Complex contagion",
                Dropdown(list(REWIRES), label="Network", onChange=pick_ring),
                m_sl,
                Row(cx_btn, Button("Start again", onClick=lambda: cx_seed())),
                Markdown(cx_text), Chart(cx_chart)),
            Tab("Shortcuts help or hurt",
                Button("Simulate: rewire more and more", onClick=lambda: cx_sweep_start()),
                Chart(cx_sweep_chart), Markdown(cx_sweep_text)),
            onChange=switch)),
    sizes={"right": 440},
)
ui.toolbar(Action("tool:select"), Action("fit"), Action("png"), "|", Action("source", "How this is built"))
ui.statusbar(Label(lambda: f"{graphNames()[0]}: {len(g.nodes)} nodes · {len(g.edges)} edges"))
center()
