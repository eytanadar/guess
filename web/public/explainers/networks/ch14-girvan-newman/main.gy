# Cutting the busiest edges  (Newman, Networks, Section 14.5.1)
# Edges that run between communities carry many shortest paths: every path
# from one group to the other must cross one of the few edges joining them.
# Girvan and Newman's method removes the edge with the highest betweenness,
# recomputes betweenness (the paths reroute), and repeats. The network falls
# apart into its communities, then into smaller and smaller pieces. The order
# of the splits is a tree, a dendrogram; cutting it where modularity is
# highest picks one division.

import random
import networkx as nx

NETS = ["Karate club (34 members)", "Planted groups: 3 × 12 (block model)"]
COLS = ["240,140,60", "80,150,230", "120,190,90", "200,110,200", "230,200,70", "100,200,200",
        "220,110,110", "160,160,230", "190,150,100", "150,210,160"]
gn = {"net": NETS[0], "names": [], "seq": [], "splits": [], "comp_at": [], "q_at": [], "merges": [],
      "heights": [], "step": 0, "timer": None, "truth": {}, "sim": None, "simrows": []}
mode = ["Cut the busiest edges"]


def short(nm):
    return "".join(c for c in nm if c.isdigit())


# the dendrogram chart's colours for a cut into k groups, so the network matches the tree: the same
# palette, and the groups in the same order (largest first) as showDendrogram assigns them
DPAL = ["78,121,167", "225,87,89", "89,161,79", "242,142,43", "118,183,178", "176,122,161", "237,201,72",
        "255,157,167", "156,117,95", "134,188,182"]


def dendro_colours(merges, n, k):
    size = {c: 1 for c in range(n)}
    members = {c: [c] for c in range(n)}
    alive = set(range(n))
    for i, (a_, b_) in enumerate(merges):
        if len(alive) <= k:
            break
        alive -= {a_, b_}
        alive.add(n + i)
        size[n + i] = size[a_] + size[b_]
        members[n + i] = members[a_] + members[b_]
    ranked = sorted(alive, key=lambda c: (-size[c], min(members[c])))   # as showDendrogram: ties by smallest index
    out = {}
    for j, c in enumerate(ranked):
        for x in members[c]:
            out[x] = DPAL[j % len(DPAL)] if size[c] > 1 else "185,185,185"
    return out


# ---- the network and the whole Girvan-Newman sequence (computed once) -----------------------------
def load(choice):
    stop_all()
    gn["net"] = choice
    if choice.startswith("Karate"):
        makeSample("karate")
        gn["truth"] = {v.name: (0 if v.club == "Mr. Hi" else 1) for v in g.nodes}
        gn["truth_name"] = "the club's actual split"
    else:
        makeBlockModel([12, 12, 12], 0.45, 0.04, seed=4, layout=false)
        gn["truth"] = {v.name: v.block for v in g.nodes}
        gn["truth_name"] = "the planted groups"
    G = toNetworkX(directed=False)
    pos = nx.spring_layout(G, seed=3, iterations=200)    # a seeded layout: the groups sit apart every time
    for v in g.nodes:
        v.x, v.y = float(pos[v.name][0]) * 430, float(pos[v.name][1]) * 430
        v.label = short(v.name)
        v.labelpos = "inside"
        v.labelvisible = true
    gn["names"] = sorted(G, key=lambda s_: int(short(s_) or 0))
    run_sequence(G)
    gn["step"] = 0
    repaint()
    center()


def run_sequence(G0):
    """Remove the highest-betweenness edge until none are left, recording each removal, the betweenness
    of every edge just before it, the components and Q after it, and the splits (for the dendrogram)."""
    G = nx.Graph(G0)
    G.remove_edges_from(list(nx.selfloop_edges(G)))
    m = G0.number_of_edges()
    seq, splits, comp_at, q_at = [], [], [], []
    comps = [frozenset(c) for c in nx.connected_components(G)]
    comp_at.append(comps)
    q_at.append(nx.community.modularity(G0, comps))
    while G.number_of_edges():
        btw = nx.edge_betweenness_centrality(G, normalized=False)
        (a_, b_), top = max(btw.items(), key=lambda kv: (kv[1], -gn["names"].index(kv[0][0])))
        G.remove_edge(a_, b_)
        seq.append({"edge": (a_, b_), "btw": dict(btw), "top": top})
        if not nx.has_path(G, a_, b_):              # this removal split a component in two
            A, B = frozenset(nx.node_connected_component(G, a_)), frozenset(nx.node_connected_component(G, b_))
            splits.append((len(seq), A, B))
            comps = [c for c in comps if not (a_ in c)] + [A, B]
        comp_at.append(list(comps))
        q_at.append(nx.community.modularity(G0, comps))
    gn["seq"], gn["splits"], gn["comp_at"], gn["q_at"] = seq, splits, comp_at, q_at
    # the dendrogram: undo the splits in reverse order. Leaves are the nodes; a split made late joins first.
    n = len(gn["names"])
    ident = {frozenset([nm]): i for i, nm in enumerate(gn["names"])}
    merges, heights = [], []
    for k, (when, A, B) in enumerate(reversed(splits)):
        merges.append((ident[A], ident[B]))
        heights.append(k + 1)                                    # the first split is the highest merge
        ident[A | B] = n + k
    gn["merges"], gn["heights"] = merges, heights


def comps_now():
    return gn["comp_at"][gn["step"]]


def colour_of(comps):
    """Each piece gets the colour its branch has in the dendrogram; single nodes are grey."""
    by_index = dendro_colours(gn["merges"], len(gn["names"]), len(comps))
    return {nm: by_index[i] for i, nm in enumerate(gn["names"])}


def repaint(flash=None):
    k = gn["step"]
    removed = {frozenset(s_["edge"]) for s_ in gn["seq"][:k]}
    btw = gn["seq"][k]["btw"] if k < len(gn["seq"]) else {}
    bmax = max(btw.values()) if btw else 1
    col = colour_of(comps_now())
    for v in g.nodes:
        v.color = col[v.name]
        v.width = v.height = 26
        v.strokecolor, v.strokewidth = "50,50,50", 0
    for e in g.edges:
        key = frozenset((e.node1.name, e.node2.name))
        if key in removed:
            e.visible = false
            continue
        e.visible = true
        b = btw.get((e.node1.name, e.node2.name), btw.get((e.node2.name, e.node1.name), 0))
        e.width = 1 + 9 * b / bmax                    # width: betweenness now
        e.linestyle = "solid"
        e.color = "120,120,120,170"
        e.label = ""
        e.labelvisible = false
        if k < len(gn["seq"]) and key == frozenset(gn["seq"][k]["edge"]):
            e.color = "235,70,60"                     # the next to go (ties broken in a fixed order)
            e.label = f"{b:.0f}"
            e.labelvisible = true
    if flash is not None:                             # the edge just removed: dashed red, ends outlined
        a_, b_ = flash
        for e in g.edges:
            if {e.node1.name, e.node2.name} == {a_, b_}:
                e.visible = true
                e.linestyle = "dashed"
                e.color = "235,70,60"
                e.width = 3
        for nm in (a_, b_):
            v = g.getNodeByName(nm)
            v.strokecolor, v.strokewidth = "20,20,20", 4
            v.width = v.height = 32
    removeConvexHulls()
    for c in comps_now():
        if 1 < len(c) < len(gn["names"]):
            first = sorted(c)[0]
            encircle([g.getNodeByName(nm) for nm in c], shape="hull", color=col[first] + ",45", padding=16)


# ---- stepping ------------------------------------------------------------------------------------------
def step_once():
    k = gn["step"]
    if k >= len(gn["seq"]):
        return False
    gn["step"] = k + 1
    repaint(flash=gn["seq"][k]["edge"])
    return len(gn["seq"]) - gn["step"] or False


def play():
    if gn["timer"] is not None and gn["timer"].running:
        stop_all()
        return
    if gn["step"] >= len(gn["seq"]):
        gn["step"] = 0
    gn["timer"] = everyPaced(step_once, slow=0.9, fast=0.12, ramp=3)
    play_btn.text = "Pause"


def to_best():
    stop_all()
    gn["step"] = best_step()
    kslider.value = min(10, groups_now())
    repaint()


def restart():
    stop_all()
    gn["step"] = 0
    repaint()


def best_step():
    q = gn["q_at"]
    return max(range(len(q)), key=lambda i: (q[i], -i))


def groups_now():
    return len(comps_now())


def cut_text():
    k = gn["step"]
    if k == 0:
        return ("Edge width shows **betweenness**: how many shortest paths between pairs of nodes run along "
                "the edge. The red one carries the most and goes next. *Remove* it, recompute, repeat.")
    s_ = gn["seq"][k - 1]
    a_, b_ = s_["edge"]
    q = gn["q_at"][k]
    split_now = any(when == k for when, _A, _B in gn["splits"])
    out = (f"Removed edge {k} of {len(gn['seq'])}: {linkTo(g.getNodeByName(a_), short(a_))}–"
           f"{linkTo(g.getNodeByName(b_), short(b_))}, which carried **{s_['top']:.0f}** shortest paths. ")
    out += ("**It split a piece in two.** " if split_now else "The network didn't come apart yet; betweenness "
            "was recomputed and the paths now crowd onto other edges. ")
    out += (f"Now **{groups_now()}** piece{'s' if groups_now() != 1 else ''}, modularity Q = **{q:.3f}** "
            f"(highest so far along the way: {max(gn['q_at'][:k + 1]):.3f}).")
    return out


def q_chart():
    k = gn["step"]
    pts = [(i, q) for i, q in enumerate(gn["q_at"][:k + 1])]
    b = best_step()
    series = {"Q of the pieces": pts}
    if k >= b:
        series["best"] = [(b, gn["q_at"][b])]
    return plotLine(series, title="Modularity as edges go", xlabel="edges removed", ylabel="Q",
                    highlight=["best"], yrange=(min(-0.05, min(q for _i, q in pts)), max(0.5, max(q for _i, q in pts) + 0.05)))


def tree_chart():
    k = max(1, groups_now())
    return showDendrogram(gn["merges"], nodes=[g.getNodeByName(nm) for nm in gn["names"]], heights=gn["heights"],
                          cut=k, title="The splits as a tree (cut at the current pieces)")


# ---- reading the tree --------------------------------------------------------------------------------------
kslider = Slider(1, 10, 2, 1, label="groups")


def cut_at(v=None):
    stop_all()
    k = int(kslider.value)
    # the step at which there are first k pieces
    for i, c in enumerate(gn["comp_at"]):
        if len(c) >= k:
            gn["step"] = i
            break
    repaint()


def read_text():
    k = groups_now()
    lab = {nm: i for i, c in enumerate(comps_now()) for nm in c}
    nmi = nmi_of(gn["truth"], lab)
    b = best_step()
    return (f"Cut into **{k}** groups: Q = **{gn['q_at'][gn['step']]:.3f}**; agreement with {gn['truth_name']} "
            f"(NMI, 1 = the same): **{nmi:.2f}**.\n\nModularity is highest with **{len(gn['comp_at'][b])}** groups "
            f"(Q = {gn['q_at'][b]:.3f}), after {b} removals. Branches in the tree are clickable: point at one to "
            "see its members in the network.")


# ---- simulate: does it find planted groups? ------------------------------------------------------------------
def sim_start():
    stop_all()
    gn["simrows"] = []
    gn["sim"] = {"i": 0, "cases": [(a_, r_) for a_ in (7.0, 6.0, 5.0, 4.0, 3.0) for r_ in range(2)]}
    gn["timer"] = everyPaced(sim_step, slow=0.6, fast=0.2, ramp=1)


def sim_step():
    sm = gn["sim"]
    if sm is None or sm["i"] >= len(sm["cases"]):
        return False
    inside, rep = sm["cases"][sm["i"]]
    sm["i"] += 1
    # 3 groups of 12, mean degree 8: `inside` neighbours inside the group, the rest outside
    p_in, p_out = inside / 11, (8 - inside) / 24
    G = nx.planted_partition_graph(3, 12, p_in, p_out, seed=17 + rep + int(inside * 10))
    truth = {v: v // 12 for v in G}
    best_q, best_part = -1, None
    H = nx.Graph(G)
    while H.number_of_edges():
        btw = nx.edge_betweenness_centrality(H, normalized=False)
        H.remove_edge(*max(btw, key=btw.get))
        comps = list(nx.connected_components(H))
        q = nx.community.modularity(G, comps)
        if q > best_q:
            best_q, best_part = q, comps
        if len(comps) > 8:
            break
    found = {v: i for i, c in enumerate(best_part) for v in c}
    nmi = nmi_of(truth, found)
    gn["simrows"].append((inside - (8 - inside), nmi, len(best_part)))
    return len(sm["cases"]) - sm["i"] or False


def nmi_of(a, b):
    import math
    from collections import Counter
    n = len(a)
    ca, cb, cab = Counter(a.values()), Counter(b.values()), Counter((a[v], b[v]) for v in a)
    mi = sum(c / n * math.log((c / n) / (ca[x] / n * cb[y] / n)) for (x, y), c in cab.items())
    ha = -sum(c / n * math.log(c / n) for c in ca.values())
    hb = -sum(c / n * math.log(c / n) for c in cb.values())
    return 2 * mi / (ha + hb) if ha + hb > 0 else 1.0


def sim_chart():
    rows = gn["simrows"]
    if not rows:
        return None
    pts = sorted((d, nmi) for d, nmi, _k in rows)
    return plotLine({"Girvan–Newman (best Q cut)": pts}, title="Finding planted groups",
                    xlabel="neighbours inside − outside", ylabel="NMI with the planted groups", dots=true,
                    yrange=(0, 1.05))


def sim_text():
    rows = gn["simrows"]
    if not rows:
        return ("*Simulate* builds networks of 3 groups of 12 (mean degree 8), from clear groups to mixed ones, "
                "runs Girvan–Newman on each and scores the best-Q division against the planted groups.")
    done = len(rows)
    return (f"{done} of 10 networks done. With most neighbours inside their group the method finds the groups "
            "exactly (NMI 1); as the groups blur it splits them wrongly. Every method has such a limit.")


# ---- plumbing ------------------------------------------------------------------------------------------------
def stop_all():
    if gn["timer"] is not None:
        gn["timer"].stop()
        gn["timer"] = None
    if "play_btn" in globals():
        play_btn.text = "Remove edges, one by one"


def switch(title):
    mode[0] = title
    stop_all()
    if title == "Read the tree":
        cut_at()
    else:
        repaint()




play_btn = Button("Remove edges, one by one", onClick=lambda: play())
load(NETS[0])
constantLabelSize(size=14)
ui.title("Cutting the busiest edges", "Networks, Section 14.5.1")
ui.layout(
    right=Column(
        Markdown("""### Girvan–Newman
Remove the edge on the most shortest paths, recompute, repeat: the
communities come apart."""),
        Dropdown(NETS, label="Network", onChange=load),
        Tabs(
            Tab("Cut the busiest edges",
                Row(play_btn, Button("One edge", onClick=lambda: step_once()),
                    Button("Start again", onClick=lambda: restart())),
                Markdown(cut_text), Chart(q_chart), Chart(tree_chart)),
            Tab("Read the tree",
                kslider, Button("Best modularity", onClick=lambda: to_best()),
                Markdown(read_text), Chart(tree_chart)),
            Tab("Simulate",
                Button("Simulate: planted groups", onClick=lambda: sim_start()),
                Markdown(sim_text), Chart(sim_chart)),
            onChange=switch)),
    sizes={"right": 410},
)
kslider.onChange = cut_at
ui.toolbar(Action("tool:select"), Action("fit"), Action("png"), "|", Action("source", "How this is built"))
ui.statusbar(Label(lambda: f"{len(g.nodes)} nodes · {len([e for e in g.edges if e.visible])} edges left · "
                           f"{groups_now()} pieces"))
center()
